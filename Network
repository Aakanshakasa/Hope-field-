"""A small, dependency-light Hopfield network (associative memory)."""
from __future__ import annotations
import numpy as np
class HopfieldNetwork:
"""Binary (+1 / -1) Hopfield network trained with the Hebbian rule."""
def __init__(self, n_neurons: int) -> None:
self.n = n_neurons
self.weights = np.zeros((n_neurons, n_neurons))
# ------------------------------------------------------------------ learning
def store(self, patterns: list[np.ndarray]) -> None:
"""Imprint patterns using Hebb's rule: W = (1/N) * sum(p p^T), no self-links."""
w = np.zeros_like(self.weights)
for p in patterns:
if p.shape != (self.n,):
raise ValueError(f"expected pattern of length {self.n}, got {p.shape}")
w += np.outer(p, p)
np.fill_diagonal(w, 0.0)
self.weights = w / self.n
# ------------------------------------------------------------------ dynamics
def energy(self, state: np.ndarray) -> float:
"""E = -1/2 * s^T W s. Never increases under asynchronous updates."""
return float(-0.5 * state @ self.weights @ state)
def recall(self, probe: np.ndarray, max_sweeps: int = 30, seed: int | None = None):
"""Relax from `probe` to a stored (or spurious) attractor.
Returns (final_state, energy_trace). One sweep = every neuron updated once
in a random order; we stop early when a full sweep changes nothing.
"""
rng = np.random.default_rng(seed)
state = probe.astype(float).copy()
trace = [self.energy(state)]
for _ in range(max_sweeps):
changed = False
for i in rng.permutation(self.n):
field = self.weights[i] @ state
new = 1.0 if field >= 0 else -1.0
if new != state[i]:
state[i] = new
changed = True
trace.append(self.energy(state))
if not changed:
break
return state, trace


